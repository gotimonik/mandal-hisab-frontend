<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. Xcode switches this to "production" automatically for App Store / TestFlight builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Time Sensitive notifications: every push breaks through Focus and stays on the lock screen. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Universal Links: mandalhisab.com links to a Mandal, invitations and sign-in emails open the app
	     (served by src/app/.well-known/apple-app-site-association). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:mandalhisab.com</string>
		<string>webcredentials:mandalhisab.com</string>
	</array>
</dict>
</plist>
