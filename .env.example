# URL of the MandalHisab API (mandal-hisab-backend), including /api/v1.
# Server-side only: the browser never talks to the API directly; it calls this app,
# which forwards requests with the user's session token.
API_URL=http://localhost:4000/api/v1

# Public URL of this frontend (used for absolute links)
NEXT_PUBLIC_APP_NAME=MandalHisab
